// expect-exit: 0
//
// CASE 7 -- A FUNCTION RETURNING THE TYPE, IMPORTED WITHOUT IT. It reads 3 at
// every pin the workbench keeps: the compiler's D-137 resolves a signature in
// its home scope, and did before DEF-105 -- which is what made O-N23 a gap in
// the annotations D-137 listed, and not a missing rule.
mod:case7_function_only;

use "./rows.npk".mk;

func:main = int32(cstring[]:_~argv) {
    if ((raw mk(3i64)).x != 3i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
