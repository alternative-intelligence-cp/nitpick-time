diff --git a/tests/unit/system_zone_etc.npk b/tests/unit/system_zone_etc.npk
new file mode 100644
index 0000000000000000000000000000000000000000..3b015c8872e395a62edaaff56fb94c1f21d9e5cc
--- /dev/null
+++ b/tests/unit/system_zone_etc.npk
@@ -0,0 +1,253 @@
+// expect-exit: 0
+// stress: 40
+// env: TZX=Asia/Tokyo
+// env: ATZ=Africa/Lagos
+//
+// The system zone's steps 2, 3 and 4, on a machine this unit makes (cycle
+// 0.3.2; `HOST.md` H-12 ... H-16, `SAFETY.md` S-20; TM-256 and TM-257).
+//
+// ASKS: with no `TZ`, which mechanism answers, with what name, on each
+// `/etc` below -- and is the lowest free descriptor the same after every call
+// as before it, so that `/etc/timezone`'s descriptor is closed on every path
+// step 3 takes (H-16, S-20)?
+//
+// MATTERS BECAUSE no machine this suite runs on has none of the three, a link
+// no distribution ships, or a `/etc/timezone` that is a directory -- and the
+// cycle README asks for each of H-15's facts and the not-found answer as a
+// test. So the unit enters a user and a mount namespace of its own and mounts
+// an empty `tmpfs` over `/etc`, by its own syscalls -- `probe22`'s shape
+// (TM-255) -- and writes each case there before it asks. The machine's `/etc`
+// is never touched: the mount is the namespace's.
+//
+// THE ENVIRONMENT holds no `TZ`, and two variables a careless step 1 would
+// read as one: `TZX=Asia/Tokyo`, which begins `TZ` but not `TZ=`, and
+// `ATZ=Africa/Lagos`, which holds `TZ=` past its start. A step 1 that read
+// either answers every case below `TzEnvironment`.
+//
+// THE PRECONDITION, AND ITS CODES (V-1d), `probe22`'s: 20 `unshare` refused;
+// 21, 22 and 23 the `setgroups`, uid and gid maps not written; 24 the `tmpfs`
+// not mounted -- each says the machine refused the namespace, and CI lifts
+// Ubuntu 24.04's restriction before the harness runs.
+//
+// EXIT CODES, one per case, clear of every arm code (TM-152) -- the source,
+// the name and `found` each case asserts, and the descriptor:
+//   30  `/etc` empty: `NotFound`, `""`, false -- not UTC (H-13.4)
+//   31  `/etc/timezone` alone, `Asia/Tokyo\n`: `EtcTimezone`, `Asia/Tokyo`
+//   32  beside it, `/etc/localtime` -> `/usr/share/zoneinfo/Europe/London`:
+//       `EtcLocaltime`, `Europe/London` -- step 2 before step 3
+//   33  a relative link, `../usr/share/zoneinfo/Asia/Kolkata`: `Asia/Kolkata`
+//   34  a dangling link, `/nonexistent/zoneinfo/Pacific/Auckland`:
+//       `Pacific/Auckland` -- the target is read, never the file (H-14)
+//   35  `/usr/share/myzoneinfo/Europe/Paris`, no `zoneinfo/` at a component's
+//       start: step 2 does not answer, `EtcTimezone`, `Asia/Tokyo`
+//   36  `/opt/zoneinfo/x/zoneinfo/Europe/Rome`: the LAST, `Europe/Rome`
+//   37  `/usr/share/zoneinfo/`, an empty tail: step 2 does not answer
+//   38  `/etc/localtime` a regular file holding `Europe/Berlin\n`: never
+//       read as bytes (H-14), step 3 answers
+//   39  `zoneinfo/Africa/Cairo`, the mark at the target's start: `Africa/Cairo`
+//   40  a link of 4 095 bytes, the longest the kernel holds, ending
+//       `/zoneinfo/Europe/Oslo`: `Europe/Oslo` -- the length is the authority
+//   41  `/etc/timezone` `Asia/Tokyo`, no newline: `Asia/Tokyo`
+//   42  `Asia/Tokyo\nEurope/Paris\n`: the first line, `Asia/Tokyo`
+//   43  `Asia/Tokyo\r\n`: `Asia/Tokyo\r` -- every byte but the newline reported
+//   44  `\nAsia/Tokyo\n`, an empty first line: `NotFound`
+//   45  an empty file: `NotFound`
+//   46  `/etc/timezone` -> `/dev/zero`: one read fills the buffer, `NotFound`
+//   47  `/etc/timezone` a directory: the read refused, `NotFound`
+//   48  a file of 4 096 bytes, `NTIME_PATH_MAX`: longer than a name, `NotFound`
+// and 80 a setup syscall of the unit's own refused after the namespace.
+//
+// SEEN RED AT PLANNING, each on a mutant of `src/host/host.npk` in a copy of
+// the tree -- one text replaced -- on both legs (`meta/roadmap/0.3/0.3.2.md`
+// §1.9): every exit from 30 to 46 is reached by one, the table there naming
+// each. 47 and 48 are BELTS: a directory's failed read takes the path an
+// empty file's does, which a mutant reddens at 45 first, and a file of 4 096
+// bytes is passed by as `/dev/zero` is, which one reddens at 46 first.
+//
+// FOUR MUTANTS IT CANNOT SEE, AND WHAT HOLDS EACH (TM-257; `HOST.md` H-15 and
+// H-16). A green run here is evidence about the exits above, and not about
+// these: step 2's `n >= NTIME_PATH_MAX` refusal deleted -- the kernel refuses
+// a link of 4 096 bytes (`probe22`), so no link it made fills the buffer;
+// the target's length read by scanning for a NUL in place of `n` --
+// `buffer_new` zeroes the buffer, so the scan stops where `n` does; and
+// `O_NONBLOCK` and `O_CLOEXEC` dropped from step 3's open -- the first would
+// block the open of a FIFO with no writer, and this harness has no timeout to
+// see a hang with; the second needs an `exec`. Each is held by reading: the
+// `?|` that takes `n` from the syscall's answer, the view built from `n`, and
+// the open's one line.
+//
+// THE `failsafe` NAMES WHAT `NITPICK-REACH-002` ASKS of a root importing
+// `host`: its eleven (`SAFETY.md` S-4) -- no loop here states a measure.
+mod:system_zone_etc;
+
+use "../../src/host/host.npk".*;
+
+error:ESetup;
+
+fixed int64:SYS_UNSHARE   = 272i64;
+fixed int64:SYS_MOUNT     = 165i64;
+fixed int64:SYS_SYMLINK   = 88i64;
+fixed int64:SYS_UNLINK    = 87i64;
+fixed int64:SYS_MKDIR     = 83i64;
+fixed int64:SYS_RMDIR     = 84i64;
+fixed int64:SYS_GETUID    = 102i64;
+fixed int64:SYS_GETGID    = 104i64;
+fixed int64:CLONE_NEWUSER = 268435456i64;    // 0x10000000
+fixed int64:CLONE_NEWNS   = 131072i64;       // 0x00020000
+
+// Write `text` to `path`, created or truncated: one `write`, all of it.
+func:put = NIL(string:path, string:text) {
+    cstring:c = relay to_cstring(path);
+    fd:f = relay open(c, ((((O_WRONLY | O_CREAT) | O_TRUNC) => int32) => int64), 420i64);
+    uint8[]:b = string_bytes(text);
+    if (b.len > 0i64) {
+        int64:n = relay write(f, b.ptr, b.len);
+        if (n != b.len) { fail ESetup; }
+    }
+    discard(relay close(f));
+    pass NIL;
+};
+
+// The namespace, `probe22`'s: 0, or the precondition's code.
+func:enter = int32() {
+    int64:me = relay sys(SYS_GETUID);
+    int64:mg = relay sys(SYS_GETGID);
+    Result<int64>:u = sys(SYS_UNSHARE, CLONE_NEWUSER | CLONE_NEWNS);
+    if (u.is_error) { pass 20i32; }
+    Result<NIL>:g = put("/proc/self/setgroups", "deny");
+    if (g.is_error) { pass 21i32; }
+    Result<NIL>:um = put("/proc/self/uid_map",
+                         string_concat(string_concat("0 ", int_to_string(me)), " 1"));
+    if (um.is_error) { pass 22i32; }
+    Result<NIL>:gm = put("/proc/self/gid_map",
+                         string_concat(string_concat("0 ", int_to_string(mg)), " 1"));
+    if (gm.is_error) { pass 23i32; }
+    cstring:fs = relay to_cstring("tmpfs");
+    cstring:at = relay to_cstring("/etc");
+    Result<int64>:m = sys(SYS_MOUNT, fs.ptr, at.ptr, fs.ptr, 0i64, 0i64);
+    if (m.is_error) { pass 24i32; }
+    pass 0i32;
+};
+
+func:link = NIL(string:target, string:path) {
+    cstring:t = relay to_cstring(target);
+    cstring:p = relay to_cstring(path);
+    discard(relay sys(SYS_SYMLINK, t.ptr, p.ptr));
+    pass NIL;
+};
+
+func:unlink = NIL(string:path) {
+    cstring:p = relay to_cstring(path);
+    discard(relay sys(SYS_UNLINK, p.ptr));
+    pass NIL;
+};
+
+// The lowest descriptor free: what `open` hands out next.
+func:lowest_fd = int64() {
+    cstring:p = relay to_cstring("/dev/null");
+    fd:f = relay open(p, ((O_RDONLY => int32) => int64), 0i64);
+    int64:k = f =>! int64;
+    discard(relay close(f));
+    pass k;
+};
+
+// One case: the answer's source, name and `found`, and the lowest free
+// descriptor the same after the call as before it.
+func:case_ok = bool(ZoneSource:src, string:want, bool:found) {
+    int64:before = relay lowest_fd();
+    SystemZone:z = raw host_system_zone();
+    int64:after = relay lowest_fd();
+    if (after != before) { pass false; }
+    if (z.source != src) { pass false; }
+    if (z.found != found) { pass false; }
+    pass string_equals(z.name, want);
+};
+
+func:main = int32(cstring[]:_~argv) {
+    int32:pre = enter() ?! ESetup;
+    if (pre != 0i32) { exit pre; }
+    string:lt = "/etc/localtime";
+    string:tz = "/etc/timezone";
+    string:tokyo = "Asia/Tokyo";
+
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 30i32; }
+    put(tz, "Asia/Tokyo\n") ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 31i32; }
+
+    // ---- step 2, with step 3's answer behind it ---------------------------
+    link("/usr/share/zoneinfo/Europe/London", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Europe/London", true) ?! ESetup)) { exit 32i32; }
+    unlink(lt) ?! ESetup;
+    link("../usr/share/zoneinfo/Asia/Kolkata", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Asia/Kolkata", true) ?! ESetup)) { exit 33i32; }
+    unlink(lt) ?! ESetup;
+    link("/nonexistent/zoneinfo/Pacific/Auckland", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Pacific/Auckland", true) ?! ESetup)) { exit 34i32; }
+    unlink(lt) ?! ESetup;
+    link("/usr/share/myzoneinfo/Europe/Paris", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 35i32; }
+    unlink(lt) ?! ESetup;
+    link("/opt/zoneinfo/x/zoneinfo/Europe/Rome", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Europe/Rome", true) ?! ESetup)) { exit 36i32; }
+    unlink(lt) ?! ESetup;
+    link("/usr/share/zoneinfo/", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 37i32; }
+    unlink(lt) ?! ESetup;
+    put(lt, "Europe/Berlin\n") ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 38i32; }
+    unlink(lt) ?! ESetup;
+    link("zoneinfo/Africa/Cairo", lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Africa/Cairo", true) ?! ESetup)) { exit 39i32; }
+    unlink(lt) ?! ESetup;
+    string:long = "/";
+    for (int64:i in 1i64..4073i64) { long = string_concat(long, "a"); }
+    long = string_concat(long, "/zoneinfo/Europe/Oslo");
+    if (string_byte_length(long) != 4095i64)                                 { exit 80i32; }
+    link(long, lt) ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcLocaltime, "Europe/Oslo", true) ?! ESetup)) { exit 40i32; }
+    unlink(lt) ?! ESetup;
+
+    // ---- step 3's shapes, with no link ------------------------------------
+    put(tz, "Asia/Tokyo") ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 41i32; }
+    put(tz, "Asia/Tokyo\nEurope/Paris\n") ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, tokyo, true) ?! ESetup))         { exit 42i32; }
+    put(tz, "Asia/Tokyo\r\n") ?! ESetup;
+    if (!(case_ok(ZoneSource.EtcTimezone, "Asia/Tokyo\r", true) ?! ESetup)) { exit 43i32; }
+    put(tz, "\nAsia/Tokyo\n") ?! ESetup;
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 44i32; }
+    put(tz, "") ?! ESetup;
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 45i32; }
+    unlink(tz) ?! ESetup;
+    link("/dev/zero", tz) ?! ESetup;
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 46i32; }
+    unlink(tz) ?! ESetup;
+    cstring:tzc = to_cstring(tz) ?! ESetup;
+    discard(sys(SYS_MKDIR, tzc.ptr, 493i64) ?! ESetup);
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 47i32; }
+    discard(sys(SYS_RMDIR, tzc.ptr) ?! ESetup);
+    string:big = "";
+    for (int64:i in 1i64..4096i64) { big = string_concat(big, "a"); }
+    put(tz, big) ?! ESetup;
+    if (!(case_ok(ZoneSource.NotFound, "", false) ?! ESetup))               { exit 48i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (ESetup)            { exit 80i32; },
+        (cal.ETimeValue)    { exit 81i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/system_zone_tz.npk b/tests/unit/system_zone_tz.npk
new file mode 100644
index 0000000000000000000000000000000000000000..858ae0da73b89cc23775d7e29f03e276050f630f
--- /dev/null
+++ b/tests/unit/system_zone_tz.npk
@@ -0,0 +1,54 @@
+// expect-exit: 0
+// stress: 40
+// env: TZ=GMT0BST,M3.5.0/1,M10.5.0
+//
+// The system zone's step 1, `$TZ` (cycle 0.3.2; `HOST.md` H-13.1, TM-256 and
+// TM-257).
+//
+// `TZ` set to a POSIX RULE STRING, `GMT0BST,M3.5.0/1,M10.5.0` -- `HOST.md`
+// H-13.1's own example. Step 1 answers, and reports the value as the text it
+// is: not parsed (`ZONE_MODEL.md` Z-12), not refused here, and not passed by
+// for `/etc/localtime`. Its refusal is the lookup's, cycle 0.6's
+// `zone_by_name`, which holds no zone of that name (TM-256). And with no `:`,
+// nothing is stripped: a step 1 that dropped the value's first byte reads
+// `MT0BST,...`.
+//
+// ON ANY MACHINE: `TZ` is step 1, so it answers before `/etc/localtime` and
+// `/etc/timezone` are read -- and on every machine this suite runs on, CI's
+// included, `/etc/localtime` is a link that WOULD answer, so a discovery that
+// tried the files first answers `EtcLocaltime` here, and is red.
+//
+// EXIT CODES, clear of every arm code (TM-152): 10 the answer's source not
+// `TzEnvironment`; 11 not found; 12 its name not `GMT0BST,M3.5.0/1,M10.5.0`.
+//
+// THE `failsafe` NAMES WHAT `NITPICK-REACH-002` ASKS of a root importing
+// `host`: its eleven (`SAFETY.md` S-4).
+mod:system_zone_tz;
+
+use "../../src/host/host.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    SystemZone:z = raw host_system_zone();
+    if (z.source != ZoneSource.TzEnvironment) { exit 10i32; }
+    if (!(z.found))                           { exit 11i32; }
+    if (!(string_equals(z.name, "GMT0BST,M3.5.0/1,M10.5.0"))) { exit 12i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (cal.ETimeValue)    { exit 80i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
