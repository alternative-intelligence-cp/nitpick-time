// expect-exit: 0
//
// CASE 2 -- THE TABLE IMPORTED WITHOUT ITS TYPE, BESIDE A STRUCT OF THE SAME
// NAME: O-N23's SILENT FORM. Through compiler `c3bdae2` this compiled, and the
// table took THIS module's `Row` -- its fields swapped -- so row 1's `x` read
// as its `y`, -4, and the program exited 10 on both legs. At compiler
// `c970483` (DEF-105) the table keeps `rows.npk`'s layout whatever this module
// declares, and reads 3. The control is its `c3bdae2` verdict, in
// `TRANSCRIPT.txt` (TM-192).
mod:case2_same_name;

use "./rows.npk".ROWS;

struct:Row = { int64:y; int64:x; };

func:main = int32(cstring[]:_~argv) {
    int64:i = 1i64;
    if (ROWS[i].x != 3i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
