// expect-exit: 0
//
// CASE 4 -- THE CONTROL: THE TABLE IMPORTED WITH ITS TYPE, BY NAME. It reads 3
// at every pin the workbench keeps, `c970483` included, so what cases 1, 2, 3
// and 6 measured through `c3bdae2` was the importer's scope and not the
// table. `tests/unit/sweep/every_oracle_date.npk` imports its corpus this way
// (TM-181), and still does (TM-192).
mod:case4_type_imported;

use "./rows.npk".Row;
use "./rows.npk".ROWS;

func:main = int32(cstring[]:_~argv) {
    int64:i = 1i64;
    if (ROWS[i].x != 3i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
