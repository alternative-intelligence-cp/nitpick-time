// expect-error: NITPICK-TYPE-084
//
// O-N20'S REGRESSION TEST, SINCE CYCLE 0.1.4c. THE REFUSAL LANDED: at
// compiler `c970483` the plain `pass NAMES[i]` below -- an implicit move -- is
// refused `NITPICK-TYPE-084` where it is written, the compiler's DEF-99.
// Until 0.1.4c this file carried no marker and was named in
// `harness/run.py`'s `EXPECT_EXEMPT` at `run:107`, as case 1 was, and
// `check_exemptions_live` failed the entry at the re-pin, as designed. THE
// CONTROL is this text at the kept `c3bdae2` pin -- `run:107` at -O0 and
// `run:95` under `opt -O2` -- appended to `TRANSCRIPT.txt` (TM-189).
// Everything below is the record as 0.1.3b wrote it.
//
// CASE 2 — THE SAME MOVE, WRITTEN AS A PLAIN `pass`. `pass NAMES[i]` from a
// function returning `string` moves the element out implicitly -- `pass` of
// a place moves, the language behaving as specified, and the shape
// `src/core/vec.npk`'s `vec_at<T>` has at an owning `T` (`SAFETY.md`
// S-18d). Nothing in the source says "move", which is what makes this the
// case an accessor over a `fixed` table would write by accident. Case 1's
// verdicts, both legs.
mod:case2_element_pass;

fixed string[2]:NAMES = ["alpha", "beta"];

func:get = string(int64:i) never fails {
    pass NAMES[i];
};

func:use_once = int64() never fails {
    string:s = raw get(1i64);
    pass string_byte_length(s);
};

func:main = int32(cstring[]:_~argv) {
    if (raw use_once() != 4i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
