// expect-exit: 0
// stress: 40
// env: TZ=/usr/share/zoneinfo/Europe/London
//
// The system zone's step 1, `$TZ` (cycle 0.3.2; `HOST.md` H-13.1, TM-256 and
// TM-257).
//
// `TZ` set to a PATH, `/usr/share/zoneinfo/Europe/London` -- a form the GNU
// C library reads as a file to load (`meta/research/tz-environment.md`).
// H-13.1 reports the value verbatim and never reads a file, so the name is
// the whole path, its `/` first: a step 1 that stripped any first byte below
// `:` with the `:`, or took the tail after `zoneinfo/` as step 2 does, reads
// another name. Whether a path names a zone is the lookup's to judge (cycle
// 0.6's `zone_by_name`, TM-256).
//
// ON ANY MACHINE: `TZ` is step 1, so it answers before `/etc/localtime` and
// `/etc/timezone` are read -- and on every machine this suite runs on, CI's
// included, `/etc/localtime` is a link that WOULD answer, so a discovery that
// tried the files first answers `EtcLocaltime` here, and is red.
//
// EXIT CODES, clear of every arm code (TM-152): 10 the answer's source not
// `TzEnvironment`; 11 not found; 12 its name not
// `/usr/share/zoneinfo/Europe/London`.
//
// THE `failsafe` NAMES WHAT `NITPICK-REACH-002` ASKS of a root importing
// `host`: its eleven (`SAFETY.md` S-4).
mod:system_zone_tz_path;

use "../../src/host/host.npk".*;

func:main = int32(cstring[]:_~argv) {
    SystemZone:z = raw host_system_zone();
    if (z.source != ZoneSource.TzEnvironment) { exit 10i32; }
    if (!(z.found))                           { exit 11i32; }
    if (!(string_equals(z.name, "/usr/share/zoneinfo/Europe/London"))) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
