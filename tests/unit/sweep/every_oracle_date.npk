// expect-exit: 0
// sweep-count: 3652059
//
// EVERY DATE PYTHON'S `datetime` COVERS, AGAINST PYTHON'S OWN ANSWERS -- the
// civil cross-oracle, `CALENDAR.md` C-18 and `TESTING.md` V-6. Its corpus is
// `tests/fixtures/civil/civil_oracle.npk`, generated by
// `tools/gen_civil_oracle.py` from `datetime` and nothing else: one row per
// year from 1 to 9999 -- the year, the day number of its 1 January, its
// length, and a DIGEST of nine fields of every one of its days. For each row,
// this walk checks the year's length against `is_leap_year`, 1 January's day
// number against `civil_date` and `date_to_days`, and then hands every day
// number of the year to `days_to_date` and folds the same nine fields of the
// date it returns -- year, month, day, `date_to_days`, `weekday_number` of
// `weekday`, `iso_week_year`, `iso_week_number`, `iso_weekday`, `day_of_year`
// -- by the corpus's fold, which must equal the row's digest. Run in full, at
// -O0 and again under `opt -O2` (B-3), on every full invocation (B-9).
//
// NOT A GATE, AND IT SAYS WHY. C-16's round trips are the gate because they
// trust nothing outside this repository; this file trusts Python, which is
// what makes it a cross-oracle. It covers years 1 ... 9999 because that is
// Python's range: the negative half has C-16's self-consistency and nothing
// else, and a defect confined to it passes here with the full count --
// `days_to_date`'s era one day late is the measured example.
//
// EXHAUSTIVE, NOT SAMPLED -- the generator's docstring says why a digest and
// not rows. A sample misses what falls between its rows: 400 Gregorian years
// are exactly 20 871 weeks, so every February 29th of a 400-multiple year is
// the same weekday, and a sample taken every seventh day meets all 24 of those
// in years 1 ... 9999 or none of them -- one taken on Mondays meets none, and
// passes a leap rule that drops them, measured.
//
// THE CORPUS'S ROW TYPE IS IMPORTED BY NAME, BESIDE THE TABLE. At every pin
// this repository has kept, a `fixed` binding's declared type is resolved in
// the IMPORTING module's scope rather than its own: imported without its
// type, the table is refused at the corpus's line with `NITPICK-TYPE-001`,
// and in a module declaring its own struct of the same name it silently takes
// that struct's layout. Imported by name, a same-named declaration here is
// refused `NITPICK-RESOLVE-001` instead -- so neither can happen to this file.
// A compiler defect, O-N23, raised at this cycle's planning with its
// reproduction (`meta/roadmap/0.1/0.1.4.md` §3).
//
// THE COUNT IS THE EVIDENCE (`TESTING.md` V-16, TM-122): N is the days that
// passed, and the harness requires it to equal the domain declared above --
// here the sum of the corpus's `days`, which is Python's count of the days in
// years 1 ... 9999. The declared domain is tagged where the specifications
// state it (`TESTING.md` V-1h).
//
// Two `for` loops over ranges, bounded by construction: no `decreases`, no
// `DecreasesViolated`, and the eleven identities of any program importing
// `cal` (`SAFETY.md` S-4) -- measured. `^` and `*%` cannot trap and arm
// nothing (the compiler's D-312).
//
// EXIT CODES, clear of every arm code (V-1j): 10 `days_to_date` refused a day
// number Python places in years 1 ... 9999; 11 `civil_date` refused a year's
// 1 January; 12 1 January's day number is not Python's; 13 a row's year is not
// its position, so the corpus is misaligned; 14 a year's digest is not
// Python's -- this file's nine fields for every day of that year are printed
// first, one line a day, in the format `tools/gen_civil_oracle.py --year Y`
// prints Python's, so `diff` names the day and the field; 15 `is_leap_year`
// disagrees with Python's length of the year; 20, 21 and 22 the `swept` line
// could not be built, could not be written, or was written short.
mod:every_oracle_date;

use "../../../src/cal/cal.npk".CivilDate;
use "../../../src/cal/cal.npk".civil_date;
use "../../../src/cal/cal.npk".is_leap_year;
use "../../../src/cal/cal.npk".date_to_days;
use "../../../src/cal/cal.npk".days_to_date;
use "../../../src/cal/cal.npk".weekday;
use "../../../src/cal/cal.npk".weekday_number;
use "../../../src/cal/cal.npk".iso_week_year;
use "../../../src/cal/cal.npk".iso_week_number;
use "../../../src/cal/cal.npk".iso_weekday;
use "../../../src/cal/cal.npk".day_of_year;
use "../../fixtures/civil/civil_oracle.npk".OracleYear;
use "../../fixtures/civil/civil_oracle.npk".ORACLE;
use "../../fixtures/civil/civil_oracle.npk".ORACLE_YEARS;

func:main = int32(cstring[]:_~argv) {
    int64:count = 0i64;
    for (int64:i in 0i64..(ORACLE_YEARS - 1i64)) {
        int64:y = i + 1i64;
        if (ORACLE[i].year != y) { exit 13i32; }
        int64:lo = ORACLE[i].first;
        int64:len = ORACLE[i].days;
        if ((is (raw is_leap_year(y)) : 366i64 : 365i64) != len) { exit 15i32; }
        Result<CivilDate>:jan1 = civil_date(y, 1i64, 1i64);
        if (jan1.is_error) { exit 11i32; }
        if (raw date_to_days(jan1.value) != lo) { exit 12i32; }
        int64:h = 0i64;
        for (int64:n in lo..(lo + len - 1i64)) {
            Result<CivilDate>:c = days_to_date(n);
            if (c.is_error) { exit 10i32; }
            h = raw fold_day(h, c.value);
            count = count + 1i64;
        }
        if (h != ORACLE[i].digest) {
            discard(raw say_year(lo, len));
            exit 14i32;
        }
    }
    int32:said = raw say_swept(count);
    if (said != 0i32) { exit said; }
    exit 0i32;
};

// The corpus's fold, one step: h XOR v, times an odd constant, modulo 2**64
// -- `^` and `*%` on `int64` are exactly the two's-complement operations the
// generator computes, and neither can trap.
func:mix = int64(int64:h, int64:v) never fails {
    pass (h ^ v) *% 1099511628211i64;
};

// The nine fields of one date, in the corpus's order, each `src/cal/`'s own
// public answer for the date `days_to_date` returned.
func:fold_day = int64(int64:h0, CivilDate:c) never fails {
    int64:h = raw mix(h0, c.year => int64);
    h = raw mix(h, c.month => int64);
    h = raw mix(h, c.day => int64);
    h = raw mix(h, raw date_to_days(c));
    h = raw mix(h, raw weekday_number(raw weekday(c)));
    h = raw mix(h, raw iso_week_year(c));
    h = raw mix(h, raw iso_week_number(c));
    h = raw mix(h, raw iso_weekday(c));
    h = raw mix(h, raw day_of_year(c));
    pass h;
};

// A year that disagrees: this file's nine fields for each of its days, one
// line a day, space-separated -- `gen_civil_oracle.py --year Y`'s format.
// Only reached after every day of the year was accepted, so the refusal
// below is a belt; the caller exits 14 whatever this returns.
func:say_year = int32(int64:lo, int64:len) never fails {
    for (int64:n in lo..(lo + len - 1i64)) {
        Result<CivilDate>:r = days_to_date(n);
        if (r.is_error) { pass 23i32; }
        CivilDate:c = r.value;
        discard(raw say_num(c.year => int64, false));
        discard(raw say_num(c.month => int64, false));
        discard(raw say_num(c.day => int64, false));
        discard(raw say_num(raw date_to_days(c), false));
        discard(raw say_num(raw weekday_number(raw weekday(c)), false));
        discard(raw say_num(raw iso_week_year(c), false));
        discard(raw say_num(raw iso_week_number(c), false));
        discard(raw say_num(raw iso_weekday(c), false));
        discard(raw say_num(raw day_of_year(c), true));
    }
    pass 0i32;
};

// One number and a space, or a newline after the last, on stdout.
func:say_num = int32(int64:v, bool:last) never fails {
    string:digits = int_to_string(v);
    string:sep = " ";
    if (last) { sep = "\n"; }
    string:text = string_concat(digits, sep);
    Result<cstring>:c = to_cstring(text);
    if (c.is_error) { pass 20i32; }
    cstring:s = c.value;
    Result<int64>:w = sys(1i64, 1i64, s.ptr, s.len);
    if (w.is_error) { pass 21i32; }
    if (w.value != s.len) { pass 22i32; }
    pass 0i32;
};

// `swept <count>` and a newline, on stdout, exactly once -- the same helper
// as the other five members', and every copy is checked on every run by the
// harness reading what it printed.
func:say_swept = int32(int64:count) never fails {
    string:digits = int_to_string(count);
    string:head = string_concat("swept ", digits);
    string:line = string_concat(head, "\n");
    Result<cstring>:c = to_cstring(line);
    if (c.is_error) { pass 20i32; }
    cstring:s = c.value;
    Result<int64>:w = sys(1i64, 1i64, s.ptr, s.len);
    if (w.is_error) { pass 21i32; }
    if (w.value != s.len) { pass 22i32; }
    pass 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
