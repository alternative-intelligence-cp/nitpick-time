// expect-exit: 0
//
// CASE 3 -- THE NON-OWNING CONTROL: case1's generic function at `T = int64`.
//
// It compiles and runs, and it SHOULD: there is nothing to move, so a copy of
// an element is a copy of an integer. Its job is to place the fault at
// GENERIC x OWNING and not at GENERIC alone -- the same three-control shape
// `generic_element_move` used for O-N17, kept because it is what made that
// finding exact.
mod:case3_generic_scalar;

struct:Vec<T> = { wild T->:items; int64:count; int64:cap; };

func:vec_init<T> = Vec<T>(int64:cap) never fails {
    int64:n = cap;
    if (n < 1i64) { n = 1i64; }
    wild int8->:mem = alloc(n * #size_of<T>());
    pass Vec{ items: mem =>! wild T->, count: 0i64, cap: n };
};

func:vec_push<T> = NIL(Vec<T>->:v, move T:x) never fails {
    T[]:room = #wild_slice<T>(v.items, v.cap);
    room[v.count] = move(x);
    v.count = v.count + 1i64;
    pass NIL;
};

func:vec_free<T> = NIL(Vec<T>->:v) never fails {
    dalloc(v.items =>! wild int8->);
    v.count = 0i64;
    v.cap = 0i64;
    pass NIL;
};

func:peek<T> = T(Vec<T>->:v, int64:i) never fails {
    T[]:s = #wild_slice<T>(v.items, v.count);
    T:answer = s[i];
    pass answer;
};

func:main = int32(cstring[]:_~argv) {
    Vec<int64>:v = raw vec_init::<int64>(2i64);
    drop vec_push(@v, 7i64);
    int64:a = raw peek::<int64>(@v, 0i64);
    if (a != 7i64) { exit 10i32; }
    drop vec_free(@v);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};

