// expect-error: NITPICK-TYPE-084
//
// O-N20'S REGRESSION TEST, SINCE CYCLE 0.1.4c. THE REFUSAL LANDED: at
// compiler `c970483` the `move` out of `NAMES` below is refused
// `NITPICK-TYPE-084` where it is written -- the compiler's DEF-99, its 1.6.0
// step 3f. Until 0.1.4c this file carried NO marker: it compiled and faulted,
// and the only marker true of it would have made the fault a committed
// expectation of this suite. It was named in `harness/run.py`'s
// `EXPECT_EXEMPT` at the verdict `run:107` instead, and
// `check_exemptions_live` failed that entry at the re-pin -- "it now stops at
// `npkc`" -- which is the landing arriving as designed. THE CONTROL is this
// text at the kept `c3bdae2` pin: `run:107` at -O0 and `run:95` under
// `opt -O2`, re-derived at cycle 0.1.4c and appended to `TRANSCRIPT.txt`
// (TM-189). Everything below is the record as 0.1.3b wrote it, in the tense
// it was true in; `README.md` beside this file has the landing.
//
// CASE 1 — AN EXPLICIT `move` OUT OF A `fixed` TABLE COMPILES, AND FAULTS.
// `move(NAMES[1])` is accepted by `npkc` at every kept pin; the emitted IR
// stores the vacancy -- `zeroinitializer` -- into the table, which is an LLVM
// `constant` global, and storing into a constant is undefined behaviour. At
// -O0 the store hits read-only memory: SIGSEGV, which `c3bdae2`'s runtime
// turns into `MachineFault`, exit 107 (raw 139 at the earlier pins). Under
// `opt -O2` the store is deleted as the UB it is, and the moved string is
// then dropped -- freeing a body that was never allocated -- which the
// allocator stops as `Unreachable`, exit 95. TWO LEGS, TWO ANSWERS, NEITHER
// OF THEM A COMPILE ERROR. The verdict recorded is the -O0 leg's, which is
// the one `_verdict` derives; `README.md` has both, and `TRANSCRIPT.txt`
// every pin.
mod:case1_element_move;

fixed string[2]:NAMES = ["alpha", "beta"];

func:take = int64() never fails {
    string:s = move(NAMES[1i64]);
    pass string_byte_length(s);
};

func:main = int32(cstring[]:_~argv) {
    if (raw take() != 4i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
