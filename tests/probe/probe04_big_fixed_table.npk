func:main = int32(cstring[]:argv) {
    // Z-7's cost model multiplies a row size by a row count. If the row is not
    // 16 bytes -- {int64, int32} padded to the int64 alignment -- every size
    // estimate in ZONE_MODEL.md is wrong.
    if (#size_of<ZoneTransition>() != 16i64)            { exit 10i32; }

    // The ends of the table, folded at compile time.
    if (TRANSITIONS[0].at_utc != -2208988800i64)                 { exit 11i32; }
    if (TRANSITIONS[0].type_index != 0i32)             { exit 12i32; }
    if (TRANSITIONS[29999].at_utc != 15934500000i64)  { exit 13i32; }
    if (TRANSITIONS[29999].type_index != 8i32)            { exit 14i32; }

    // A row reached through an index the compiler cannot fold: `argv.len` is 1
    // under the harness, so this is row 12345 -- but only at run time, which is
    // the access Z-8's binary search actually makes.
    int64:live = ((argv.len =>! int64) - 1i64) + 12345i64;
    if (TRANSITIONS[live].at_utc != 5257360800i64)      { exit 15i32; }
    if (TRANSITIONS[live].type_index != 8i32)          { exit 16i32; }

    // The whole table walked once: every row readable, and strictly increasing
    // -- Z-8's invariant, and the proof that all 30000 rows really are present
    // rather than the two ends the folder could have kept.
    int64:i = 1i64;
    int64:prev = TRANSITIONS[0].at_utc;
    while (i < 30000i64) {
        int64:at = TRANSITIONS[i].at_utc;
        if (at <= prev)                                 { exit 17i32; }
        prev = at;
        i = i + 1i64;
    }
    if (prev != 15934500000i64)                          { exit 18i32; }

    // D-151: exit 0 additionally asserts that nothing leaked.
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
