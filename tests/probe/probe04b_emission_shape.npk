    ZoneTransition{ at_utc: -2042985600i64, type_index: 1i32 },
    ZoneTransition{ at_utc: -2042377200i64, type_index: 2i32 },
    ZoneTransition{ at_utc: -2041768800i64, type_index: 3i32 },
    ZoneTransition{ at_utc: -2041160400i64, type_index: 4i32 },
    ZoneTransition{ at_utc: -2040552000i64, type_index: 5i32 },
    ZoneTransition{ at_utc: -2039943600i64, type_index: 6i32 },
    ZoneTransition{ at_utc: -2039335200i64, type_index: 7i32 },
    ZoneTransition{ at_utc: -2038726800i64, type_index: 8i32 },
    ZoneTransition{ at_utc: -2038118400i64, type_index: 9i32 },
    ZoneTransition{ at_utc: -2037510000i64, type_index: 10i32 },
    ZoneTransition{ at_utc: -2036901600i64, type_index: 11i32 },
    ZoneTransition{ at_utc: -2036293200i64, type_index: 12i32 },
    ZoneTransition{ at_utc: -2035684800i64, type_index: 0i32 },
    ZoneTransition{ at_utc: -2035076400i64, type_index: 1i32 },
    ZoneTransition{ at_utc: -2034468000i64, type_index: 2i32 },
    ZoneTransition{ at_utc: -2033859600i64, type_index: 3i32 },
    ZoneTransition{ at_utc: -2033251200i64, type_index: 4i32 },
    ZoneTransition{ at_utc: -2032992000i64, type_index: 5i32 },
    ZoneTransition{ at_utc: -2032383600i64, type_index: 6i32 },
    ZoneTransition{ at_utc: -2031775200i64, type_index: 7i32 },
    ZoneTransition{ at_utc: -2031166800i64, type_index: 8i32 },
    ZoneTransition{ at_utc: -2030558400i64, type_index: 9i32 },
    ZoneTransition{ at_utc: -2029950000i64, type_index: 10i32 },
    ZoneTransition{ at_utc: -2029341600i64, type_index: 11i32 },
    ZoneTransition{ at_utc: -2028733200i64, type_index: 12i32 },
    ZoneTransition{ at_utc: -2028124800i64, type_index: 0i32 }
];

func:main = int32(cstring[]:argv) {
    // The row size Z-7's cost model multiplies by a row count.
    if (#size_of<ZoneTransition>() != 16i64)            { exit 10i32; }

    // The ends of the table, folded at compile time.
    if (TRANSITIONS[0].at_utc != -2208988800i64)        { exit 11i32; }
    if (TRANSITIONS[0].type_index != 0i32)              { exit 12i32; }
    if (TRANSITIONS[299].at_utc != -2028124800i64)      { exit 13i32; }
    if (TRANSITIONS[299].type_index != 0i32)            { exit 14i32; }

    // A row reached through an index the compiler cannot fold: `argv.len` is 1
    // under the harness, so this is row 123 -- but only at run time, which is
    // the access Z-8's binary search actually makes.
    int64:live = ((argv.len =>! int64) - 1i64) + 123i64;
    if (TRANSITIONS[live].at_utc != -2134504800i64)     { exit 15i32; }
    if (TRANSITIONS[live].type_index != 6i32)           { exit 16i32; }

    // Every row readable and strictly increasing -- Z-8's invariant, and the
    // proof that all 300 rows are present rather than the two ends a folder
    // could have kept.
    int64:i = 1i64;
    int64:prev = TRANSITIONS[0].at_utc;
    while (i < 300i64) {
        int64:at = TRANSITIONS[i].at_utc;
        if (at <= prev)                                 { exit 17i32; }
        prev = at;
        i = i + 1i64;
    }
    if (prev != -2028124800i64)                         { exit 18i32; }

    // D-151: exit 0 additionally asserts that nothing leaked.
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
