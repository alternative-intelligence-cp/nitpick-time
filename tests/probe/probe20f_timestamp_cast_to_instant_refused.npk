// expect-error: NITPICK-TYPE-032
//
// PROBE 20f — NOT EVEN `=>!` TURNS A `Timestamp` INTO AN `Instant` (cycle
// 0.2.1, TM-221; `TIME_MODEL.md` M-3: "in either direction, ever").
//
// ASKS: may a consumer reinterpret a point on the absolute scale as a reading
// of the monotonic clock with the language's unchecked cast, `t =>! Instant`?
//
// MATTERS BECAUSE the cast in this direction would manufacture an
// `InstantClock` tag from a `uint32` -- which `=>!` permits between an
// integer and an enum (the compiler's D-140, `SAFETY.md` S-15c) -- so the two
// directions are separate questions, and `probe20e` answers only the other.
// ANSWER, measured at `5fbaf4a`: NO -- `NITPICK-TYPE-032`, "there is no
// conversion from `Timestamp` to `Instant`: these types have no values in
// common", exactly once. THE REFUSAL IS THE ASSERTION (B-7).
mod:probe20f_timestamp_cast_to_instant_refused;

use "../../src/span/span.npk".*;

func:main = int32(cstring[]:_~argv) {
    Result<Timestamp>:r = timestamp_of(1000i64, 0i64);
    if (r.is_error) { exit 10i32; }
    Instant:a = r.value =>! Instant;
    exit 0i32;
};

// A SUPERSET of what `NITPICK-REACH-002` asks of a root importing `span`,
// deliberately, as `probe16d` has (`SAFETY.md` S-6b, constraint 3: a superset
// compiles): a later compiler that ran the reach analysis before the check this
// file asserts could not add a stray `REACH-002` to the refusal.
func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
