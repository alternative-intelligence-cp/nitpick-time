// expect-error: NITPICK-BORROW-012
//
// PROBE 10b — a view of a TEMPORARY, returned. THE NEGATIVE TWIN.
//
// ASKS: what happens to `string_bytes(string_concat(a, b))` returned, where
// the string viewed has no name at all?
//
// MATTERS BECAUSE it is the one shape DEF-3 could not report with an existing
// code. Every other refusal DEF-3 adds is shaped like "as if `@` had been
// written at that argument" and so is `NITPICK-BORROW-001`; but `@` of a
// temporary cannot be SPELLED, so no existing code's text is true of it, and
// tracking it would need a root with no name. The compiler allocated
// `NITPICK-BORROW-012` (`BORROW_VIEW_OF_TEMPORARY`,
// `src/frontend/analysis/analysis_codes.npk`) for exactly this.
//
// AND THIS FILE IS THE CORRECTION OF A RECORDED MISTAKE. On 2026-09-03 this
// repository grepped the then-pinned compiler for `BORROW-012`, found nothing,
// and wrote into its own execution record that the code "DOES NOT EXIST". The
// grep was right about the tree it read and wrong about the world: the code was
// real and lived in DEF-3's unlanded step-2 worktree, which a pin cannot show.
// The pin proves "not landed", never "not real" (`../../../PLAYBOOK.md` §6).
// This file is the measurement that settles it, at a pin that HAS the landing.
//
// THE FIX IS THE DIAGNOSTIC'S OWN ADVICE: bind the intermediate, and the view
// becomes an ordinary borrow of that binding, checked like any other. That is
// also the cure for the separate leak the same temporary has under D-246 --
// one habit answers both.
mod:probe10b_view_of_temporary_refused;

func:esc = uint8[]() never fails {
    // `string_concat` allocates and the result is bound to nothing. It dies at
    // this statement's end (D-246), and the view would outlive it by a frame.
    pass string_bytes(string_concat("abcd", "efgh"));
};

func:main = int32(cstring[]:_~argv) {
    uint8[]:v = raw esc();
    if (v.len != 8i64) { exit 20i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
