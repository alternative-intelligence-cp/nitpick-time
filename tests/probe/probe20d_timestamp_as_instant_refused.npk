// expect-error: NITPICK-TYPE-007
//
// PROBE 20d — A `Timestamp` IS NOT AN `Instant`, EVEN WHERE ONE IS TAKEN
// (cycle 0.2.1, TM-221; `TIME_MODEL.md` M-3: "in either direction").
//
// ASKS: may a consumer measure, on the monotonic clock, the time since a
// point on the absolute scale -- `instant_since(a, t)`, `t` a `Timestamp`?
//
// MATTERS BECAUSE that is the timeout written against a wall clock, from the
// other side: NTP steps the realtime clock a `Timestamp` is read from, never
// the monotonic one, so their distance means nothing. `probe20c` asks
// the direction the cycle README asked first; M-3 refuses both. ANSWER,
// measured at `5fbaf4a`: NO -- `NITPICK-TYPE-007`, "expected `Instant`,
// found `Timestamp`", exactly once, at the argument. THE REFUSAL IS THE
// ASSERTION (B-7). One probe per refusal (TM-218): a file refused for two
// reasons could not say which went away.
mod:probe20d_timestamp_as_instant_refused;

use "../../src/span/span.npk".*;

func:main = int32(cstring[]:_~argv) {
    Instant:a = raw instant_of(1000i64, InstantClock.Monotonic);
    Result<Timestamp>:r = timestamp_of(1000i64, 0i64);
    if (r.is_error) { exit 10i32; }
    Result<Duration>:d = instant_since(a, r.value);
    exit 0i32;
};

// A SUPERSET of what `NITPICK-REACH-002` asks of a root importing `span`,
// deliberately, as `probe16d` has (`SAFETY.md` S-6b, constraint 3: a superset
// compiles): a later compiler that ran the reach analysis before the check this
// file asserts could not add a stray `REACH-002` to the refusal.
func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
