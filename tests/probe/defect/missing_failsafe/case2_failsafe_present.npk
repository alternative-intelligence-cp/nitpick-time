// THE CONTRAST, and the reason case 1 is evidence rather than an assertion.
// Character for character `case1_no_failsafe.npk`, plus a `failsafe` naming
// the four unconditional floor arms and the wildcard.
//
// All four steps exit 0 and the program runs. So the difference between a file
// `npkc` accepts and links, and a file `npkc` accepts and `llc` refuses, is
// exactly the presence of the declaration below -- and `npkc`'s exit code is 0
// for both.
mod:case2_failsafe_present;

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};
