// expect-exit: 0
//
// CASE 1 -- THE TABLE IMPORTED WITHOUT ITS TYPE: O-N23's LOUD FORM. Through
// compiler `c3bdae2` this was refused `NITPICK-TYPE-001` -- "there is no type
// named `Row`" -- at `rows.npk`'s own line, which compiles alone: the
// table's declared type was resolved in THIS module's scope. At compiler
// `c970483` (the compiler's DEF-105) it resolves in `rows.npk`'s, and the
// program reads row 1's `x`, which is 3. Exit 10 is a wrong read. The control
// is its `c3bdae2` verdict, in `TRANSCRIPT.txt` (TM-192). The `failsafe` names
// what `NITPICK-REACH-002` asks at `c970483`, and nothing more.
mod:case1_table_only;

use "./rows.npk".ROWS;

func:main = int32(cstring[]:_~argv) {
    int64:i = 1i64;
    if (ROWS[i].x != 3i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
