+    string:target = string_from_bytes(b.ptr, n);
+    uint8[]:tb = string_bytes(target);
+    string:mark = "zoneinfo/";
+    uint8[]:mb = string_bytes(mark);
+    int64:lo = -1i64;
+    for (int64:i in 0i64..(tb.len - mb.len)) {
+        bool:same = true;
+        if (i > 0i64) { same = (tb[i - 1i64] == 47u8); }                // `/`
+        for (int64:j in 0i64..(mb.len - 1i64)) {
+            if (tb[i + j] != mb[j]) { same = false; }
+        }
+        if (same) { lo = i + mb.len; }
+    }
+    if (lo < 0i64) { pass raw zone_none(); }
+    if (lo >= tb.len) { pass raw zone_none(); }
+    string:name = string_slice(target, lo, tb.len) ?| #unreachable();
+    pass SystemZone{ name: move(name), source: ZoneSource.EtcLocaltime, found: true };
+};
+
+// STEP 3, `/etc/timezone` (H-13.3, H-16, `SAFETY.md` S-20): the library's one
+// descriptor. Opened `O_RDONLY | O_NONBLOCK | O_CLOEXEC` -- `O_NONBLOCK` so a
+// FIFO at that path never blocks the open (S-21: `ntime` blocks on nothing),
+// `O_CLOEXEC` so the descriptor never outlives the call into an `exec` -- and
+// owned at once by an `OwnedFd`, whose drop closes it: every `pass` below is a
+// path out, and each one closes it, by construction rather than by a `close`
+// on each path. ONE read of up to `NTIME_PATH_MAX` bytes: a read that fills
+// the buffer is longer than any name, and does not answer -- a link to
+// `/dev/zero` is read once, and is not a name. The name is the bytes before
+// the first newline, every other byte reported as the file holds it; an empty
+// first line, an empty file (the floor's `E_EOF`), or any error -- no file, a
+// directory, a FIFO with no writer -- and the step does not answer.
+func:zone_from_timezone = SystemZone() never fails {
+    cstring:path = to_cstring("/etc/timezone") ?| #unreachable();
+    Result<fd>:o = open(path, ((((O_RDONLY | O_NONBLOCK) | O_CLOEXEC) => int32) => int64),
+                        ((S_NONE => int32) => int64));
+    if (o.is_error) { pass raw zone_none(); }
+    OwnedFd:d = own_fd(o.value);
+    buffer:b = buffer_new(NTIME_PATH_MAX);
+    int64:n = read(d.value, b.ptr, NTIME_PATH_MAX) ?| -1i64;
+    if (n <= 0i64) { pass raw zone_none(); }
+    if (n >= NTIME_PATH_MAX) { pass raw zone_none(); }                  // longer than a name
+    string:text = string_from_bytes(b.ptr, n);
+    uint8[]:fb = string_bytes(text);
+    int64:e = fb.len;
+    for (int64:i in 0i64..(fb.len - 1i64)) {
+        if (fb[i] == 10u8) { e = i; break; }                            // `\n`
+    }
+    if (e == 0i64) { pass raw zone_none(); }
+    string:name = string_slice(text, 0i64, e) ?| #unreachable();
+    pass SystemZone{ name: move(name), source: ZoneSource.EtcTimezone, found: true };
+};
+
+// `HOST.md` H-12 and H-13: the four steps, in order, stopping at the first
+// that answers; the fourth is `NotFound`, `found: false` -- not UTC, and not
+// an error (TM-019). `never fails`: a step whose source cannot be read has not
+// answered, so nothing is left to fail but what traps -- an allocation, or a
+// copy out of bounds that cannot happen. Two calls are two discoveries (H-3):
+// nothing is kept between them.
+pub func:host_system_zone = SystemZone() never fails {
+    SystemZone:z = raw zone_from_tz();
+    if (z.found) { pass z; }
+    z = raw zone_from_localtime();
+    if (z.found) { pass z; }
+    z = raw zone_from_timezone();
+    if (z.found) { pass z; }
+    pass raw zone_none();
+};
