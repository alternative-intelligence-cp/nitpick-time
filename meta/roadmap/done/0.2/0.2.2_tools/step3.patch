diff --git a/tests/unit/civil_to_utc_edges.npk b/tests/unit/civil_to_utc_edges.npk
new file mode 100644
index 0000000000000000000000000000000000000000..c21a73715c85f02681f848b10bcec8de5d86c597
--- /dev/null
+++ b/tests/unit/civil_to_utc_edges.npk
@@ -0,0 +1,170 @@
+// expect-exit: 0
+//
+// `civil_to_utc` at every boundary it decides, from both sides, and every
+// `Timestamp` it returns normalised (cycle 0.2.2; TM-225; `VERIFICATION.md`
+// P-4, `TIME_MODEL.md` M-7 and M-8).
+//
+// ASKS: does `civil_to_utc` convert every civil reading whose instant lies in
+// the range, and refuse every one whose instant lies outside it or whose
+// `nanos` is a second or more -- and is every `Timestamp` it returns
+// normalised?
+//
+// MATTERS BECAUSE P-4 asks that no sequence of operations produce a
+// denormalised `Timestamp`, and `civil_to_utc` is the first operation since
+// `timestamp_of` to yield one. THIS FILE EXTENDS P-4'S STAND-IN TO IT (P-1b),
+// beside `tests/unit/timestamp_construct.npk` and the seal's two probes. A
+// reading built by `civil_date` and `civil_time` always converts -- its date
+// is in the range and its `nanos` below a second (`CALENDAR.md` C-8c, C-9) --
+// so the refusing side of each boundary is built through the opt-out C-8c
+// names, `wild` storage reinterpreted, as `tests/unit/civil_total_edges.npk`
+// builds its dates. That side is what tells a conversion that builds through
+// `timestamp_of` from one that writes a `Timestamp` literal: handed a forged
+// `nanos` of one second, the second returns a denormalised value.
+//
+// THE CASES are the cross product of six dates -- the day before the range
+// (forged, year -10000), its first day, 1969-12-31, 1970-01-01, its last day,
+// and the day after it (forged, year 10000) -- and five times -- 00:00:00,
+// one nanosecond past it, 23:59:59.999999999, and 23:59:59 with a `nanos` of
+// one second and of 2^32 - 1 (both forged): thirty pairs, 12 accepted and 18
+// refused, every verdict WRITTEN in the tables below rather than computed, and
+// each accepted value's instant computed from the day numbers written beside
+// the dates. Every forged value is read back field by field before it is
+// converted, so a forge that wrote the wrong bytes exits with its own code.
+//
+// EXIT CODES, clear of every arm code (TM-152): 30 `civil_date` or
+// `civil_time` refused a reading in its range; 31 a forged date did not read
+// back; 32 a forged time did not; 33 a pair in range refused; 34 an accepted
+// pair's seconds not the instant's; 35 its nanoseconds not; 36 an accepted
+// value's `nanos` not below one second -- M-7 itself, held apart from the
+// tables; 37 a pair out of range accepted; 38 the counts are not 12 and 18.
+// SEEN RED AT PLANNING, on both legs, in a copy of the tree
+// (`meta/roadmap/0.2/0.2.2.md`, step 3): 30 with `civil_time` refusing the
+// last nanosecond of a second; 33 with `timestamp_of`'s lower bound one high;
+// 34 with `civil_to_utc`'s minutes counted as 59 seconds; 35 with its
+// nanoseconds dropped; 37 with it writing a `Timestamp` literal instead of
+// calling `timestamp_of`, and with `timestamp_of`'s upper bound deleted. 31,
+// 32, 36 and 38 are reached only by editing this file, and were so measured:
+// 31 with the date's forge declaring its month and day the other way round,
+// 32 with the time's declaring its hour and minute so, 36 when the tables and
+// the literal are wrong together, and 38 when the loop is cut short.
+//
+// THE `failsafe` NAMES WHAT `NITPICK-REACH-002` ASKS of a root importing
+// `span` and `cal`: `span`'s eleven (`SAFETY.md` S-4).
+mod:civil_to_utc_edges;
+
+use "../../src/span/span.npk".*;
+use "../../src/cal/cal.npk".CivilDate;
+use "../../src/cal/cal.npk".CivilTime;
+use "../../src/cal/cal.npk".CivilDateTime;
+use "../../src/cal/cal.npk".civil_date;
+use "../../src/cal/cal.npk".civil_time;
+use "../../src/core/limits.npk".NTIME_NANOS_PER_SEC;
+
+// `CivilDate` and `CivilTime` field for field, unsealed -- the forge's shapes.
+// Each is 8 bytes, as the sealed types are (measured at planning), and every
+// forged value is read back through the sealed type before it is used.
+struct:RawDate = { int32:year; uint8:month; uint8:day; };
+struct:RawTime = { uint8:hour; uint8:minute; uint8:second; uint32:nanos; };
+
+fixed int64[6]:Y           = [ -10000i64, -9999i64, 1969i64, 1970i64, 9999i64, 10000i64 ];
+fixed int64[6]:M           = [ 12i64, 1i64, 12i64, 1i64, 12i64, 1i64 ];
+fixed int64[6]:D           = [ 31i64, 1i64, 31i64, 1i64, 31i64, 1i64 ];
+fixed int64[6]:DAYNUM      = [ -4371588i64, -4371587i64, -1i64, 0i64, 2932896i64, 2932897i64 ];
+fixed bool[6]:DATE_FORGED  = [ true, false, false, false, false, true ];
+fixed bool[6]:DATE_IN      = [ false, true, true, true, true, false ];
+
+fixed int64[5]:H           = [ 0i64, 0i64, 23i64, 23i64, 23i64 ];
+fixed int64[5]:MI          = [ 0i64, 0i64, 59i64, 59i64, 59i64 ];
+fixed int64[5]:S           = [ 0i64, 0i64, 59i64, 59i64, 59i64 ];
+fixed int64[5]:N           = [ 0i64, 1i64, 999999999i64, 1000000000i64, 4294967295i64 ];
+fixed bool[5]:TIME_FORGED  = [ false, false, false, true, true ];
+fixed bool[5]:TIME_IN      = [ true, true, true, false, false ];
+
+func:main = int32(cstring[]:_~argv) {
+    wild int8->:md = alloc(8i64);
+    wild int8->:mt = alloc(8i64);
+    int64:accepted = 0i64;
+    int64:refused = 0i64;
+    for (int64:i in 0i64..5i64) {
+        for (int64:j in 0i64..4i64) {
+            CivilDate:cd = raw forged_date(md, i);
+            CivilTime:ct = raw forged_time(mt, j);
+            if (!(DATE_FORGED[i])) {
+                Result<CivilDate>:rd = civil_date(Y[i], M[i], D[i]);
+                if (rd.is_error) { dalloc(md); dalloc(mt); exit 30i32; }
+                cd = rd.value;
+            }
+            if (!(TIME_FORGED[j])) {
+                Result<CivilTime>:rt = civil_time(H[j], MI[j], S[j], N[j]);
+                if (rt.is_error) { dalloc(md); dalloc(mt); exit 30i32; }
+                ct = rt.value;
+            }
+            int32:back = raw read_back(cd, ct, i, j);
+            if (back != 0i32) { dalloc(md); dalloc(mt); exit back; }
+            Result<Timestamp>:r = civil_to_utc(CivilDateTime{ date: cd, time: ct });
+            if (DATE_IN[i] && TIME_IN[j]) {
+                if (r.is_error) { dalloc(md); dalloc(mt); exit 33i32; }
+                int64:want = (DAYNUM[i] * 86400i64) + (H[j] * 3600i64) + (MI[j] * 60i64) + S[j];
+                if (r.value.secs != want)                            { dalloc(md); dalloc(mt); exit 34i32; }
+                if ((r.value.nanos => int64) != N[j])                { dalloc(md); dalloc(mt); exit 35i32; }
+                if ((r.value.nanos => int64) >= NTIME_NANOS_PER_SEC) { dalloc(md); dalloc(mt); exit 36i32; }
+                accepted = accepted + 1i64;
+            } else {
+                if (!(r.is_error)) { dalloc(md); dalloc(mt); exit 37i32; }
+                refused = refused + 1i64;
+            }
+        }
+    }
+    dalloc(md);
+    dalloc(mt);
+    if (accepted != 12i64 || refused != 18i64) { exit 38i32; }
+    exit 0i32;
+};
+
+// A `CivilDate` built through `wild` storage from row `i` of the date table --
+// the opt-out C-8c names. Its fields are checked by `read_back`.
+func:forged_date = CivilDate(wild int8->:mem, int64:i) never fails {
+    wild RawDate->:w = mem =>! wild RawDate->;
+    <-w = RawDate{ year: Y[i] =>! int32, month: M[i] =>! uint8, day: D[i] =>! uint8 };
+    wild CivilDate->:r = mem =>! wild CivilDate->;
+    pass <-r;
+};
+
+// The same for row `j` of the time table.
+func:forged_time = CivilTime(wild int8->:mem, int64:j) never fails {
+    wild RawTime->:w = mem =>! wild RawTime->;
+    <-w = RawTime{ hour: H[j] =>! uint8, minute: MI[j] =>! uint8,
+                   second: S[j] =>! uint8, nanos: N[j] =>! uint32 };
+    wild CivilTime->:r = mem =>! wild CivilTime->;
+    pass <-r;
+};
+
+// 0, or 31 / 32 when a field of the date or the time is not its table's.
+func:read_back = int32(CivilDate:cd, CivilTime:ct, int64:i, int64:j) never fails {
+    if ((cd.year => int64) != Y[i] || (cd.month => int64) != M[i] || (cd.day => int64) != D[i]) {
+        pass 31i32;
+    }
+    if ((ct.hour => int64) != H[j] || (ct.minute => int64) != MI[j]
+        || (ct.second => int64) != S[j] || (ct.nanos => int64) != N[j]) {
+        pass 32i32;
+    }
+    pass 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (cal.ETimeValue)    { exit 80i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/sweep/every_day_boundary.npk b/tests/unit/sweep/every_day_boundary.npk
new file mode 100644
index 0000000000000000000000000000000000000000..70139120cfc3f3fa45b2ffa03eab5566378c5525
--- /dev/null
+++ b/tests/unit/sweep/every_day_boundary.npk
@@ -0,0 +1,159 @@
+// expect-exit: 0
+// sweep-count: 7304484
+//
+// EVERY DAY BOUNDARY IN THE RANGE, FROM BOTH SIDES, AS A `Timestamp` AND AS A
+// CIVIL READING -- the first half of cycle 0.2's gate (`TESTING.md` V-2, V-4;
+// `TIME_MODEL.md` M-11; TM-224). For every date in [-9999-01-01, 9999-12-31],
+// walked by the leap rule and the month table: its first instant, 00:00:00,
+// and its last, 23:59:59.999999999, each go from a `Timestamp` to their civil
+// reading and from the civil reading back to the `Timestamp`. Run in full, at
+// -O0 and again under `opt -O2` (B-3), on every full invocation (B-9).
+//
+// BOTH SIDES OF EACH BOUNDARY, BECAUSE ONE SIDE CANNOT SEE THE FLOOR. A day's
+// first instant is a whole number of days from the epoch, and there a
+// truncating division and a flooring one agree; its last instant, before the
+// epoch, is where they part -- `-1 s` is 1969-12-31T23:59:59, and a
+// truncation hands `civil_time` a second of -1. With the last instants alone
+// the boundary is seen from the left, with the first alone from the right,
+// and every boundary between two days is the first instant of one and the
+// last of the other.
+//
+// EACH DIRECTION IS HANDED THE WALK'S VALUE, NOT THE OTHER DIRECTION'S ANSWER
+// (`TESTING.md` V-4b, TM-174). The walk's date is built by `civil_date` from
+// the walk's integers, and its instant is a COUNT of seconds -- begun at
+// `NTIME_SECS_MIN`, advanced by one day per date -- so `civil_to_utc` is held
+// to a number neither conversion computed, and `timestamp_to_utc` to the
+// walk's integers. The reverse runs first, so a `cal` constructor that refuses
+// a walked date is seen at 12 rather than inside a conversion. The walk is
+// `every_civil_date.npk`'s, which the gate of cycle 0.1 holds to C-16.
+//
+// THE COUNT IS THE EVIDENCE (`TESTING.md` V-16, TM-122): N is the dates whose
+// two instants passed every check, and the harness requires it to equal the
+// domain declared above, which is tagged where the specifications state it
+// (`TESTING.md` V-1h, TM-168).
+//
+// Three `for` loops over ranges, bounded by construction: no `decreases`, no
+// `DecreasesViolated`, and the eleven identities of any program importing
+// `span` (`SAFETY.md` S-4) -- measured.
+//
+// EXIT CODES, clear of every arm code (V-1j): 10 `civil_time` refused
+// 00:00:00 or 23:59:59.999999999; 11 `days_in_month` refused a month from 1 to
+// 12; 12 `civil_date` refused a date the month's length admits; 13
+// `civil_to_utc` refused a date's first instant; 14 its answer is not the
+// count; 15 it refused a date's last instant; 16 its answer is not the count
+// plus 86 399 s and 999 999 999 ns; 17 `timestamp_of` refused the count's
+// first or last instant; 18 `timestamp_to_utc`'s date for the first instant is
+// not the walk's; 19 its time is not 00:00:00; 23 its date for the last
+// instant is not the walk's; 24 its time is not 23:59:59.999999999; 25 the
+// walk did not end on `NTIME_SECS_MAX`'s second; 20, 21 and 22 the `swept`
+// line could not be built, could not be written, or was written short. SEEN
+// RED AT PLANNING, on both legs, in a copy of the tree
+// (`meta/roadmap/0.2/0.2.2.md`, step 3): 10 with `civil_time` refusing the
+// last nanosecond of a second; 11 with `days_in_month` refusing December; 12
+// with `civil_date` refusing a month's last day; 13 with `civil_to_utc` a
+// second short; 14 with it a second long; 15 with its nanoseconds doubled; 16
+// with its minutes counted as 61 seconds; 18 with `timestamp_to_utc` a day
+// late; 19 with its nanoseconds one high; 23 with the floor's correction
+// moving the second and not the day; 24 with the minute divided by 61, and
+// with the nanoseconds dropped; 25 with the walk's last year cut; and with
+// the correction deleted
+// -- the truncation -- `civil_time` refuses the first day's last second, and
+// the file stops at 95, `Unreachable`. 17 is a guard: `civil_to_utc` builds
+// through the same `timestamp_of`, so a constructor that refuses the count
+// stops at 13 or 15 first.
+mod:every_day_boundary;
+
+use "../../../src/span/span.npk".*;
+use "../../../src/cal/cal.npk".CivilDate;
+use "../../../src/cal/cal.npk".CivilTime;
+use "../../../src/cal/cal.npk".CivilDateTime;
+use "../../../src/cal/cal.npk".civil_date;
+use "../../../src/cal/cal.npk".civil_time;
+use "../../../src/cal/cal.npk".days_in_month;
+use "../../../src/core/limits.npk".NTIME_YEAR_MIN;
+use "../../../src/core/limits.npk".NTIME_YEAR_MAX;
+use "../../../src/core/limits.npk".NTIME_SECS_MIN;
+use "../../../src/core/limits.npk".NTIME_SECS_MAX;
+use "../../../src/core/limits.npk".NTIME_SECS_PER_DAY;
+
+func:main = int32(cstring[]:_~argv) {
+    Result<CivilTime>:t0 = civil_time(0i64, 0i64, 0i64, 0i64);
+    if (t0.is_error) { exit 10i32; }
+    Result<CivilTime>:t1 = civil_time(23i64, 59i64, 59i64, 999999999i64);
+    if (t1.is_error) { exit 10i32; }
+    int64:count = 0i64;
+    int64:secs = NTIME_SECS_MIN;
+    for (int64:y in NTIME_YEAR_MIN..NTIME_YEAR_MAX) {
+        for (int64:m in 1i64..12i64) {
+            Result<int64>:dim = days_in_month(y, m);
+            if (dim.is_error) { exit 11i32; }
+            for (int64:d in 1i64..dim.value) {
+                Result<CivilDate>:cd = civil_date(y, m, d);
+                if (cd.is_error) { exit 12i32; }
+                int64:last = secs + (NTIME_SECS_PER_DAY - 1i64);
+                Result<Timestamp>:b0 = civil_to_utc(CivilDateTime{ date: cd.value, time: t0.value });
+                if (b0.is_error) { exit 13i32; }
+                if (b0.value.secs != secs || b0.value.nanos != 0u32) { exit 14i32; }
+                Result<Timestamp>:b1 = civil_to_utc(CivilDateTime{ date: cd.value, time: t1.value });
+                if (b1.is_error) { exit 15i32; }
+                if (b1.value.secs != last || b1.value.nanos != 999999999u32) { exit 16i32; }
+                Result<Timestamp>:a0 = timestamp_of(secs, 0i64);
+                if (a0.is_error) { exit 17i32; }
+                Result<Timestamp>:a1 = timestamp_of(last, 999999999i64);
+                if (a1.is_error) { exit 17i32; }
+                CivilDateTime:c0 = raw timestamp_to_utc(a0.value);
+                if ((c0.date.year => int64) != y)  { exit 18i32; }
+                if ((c0.date.month => int64) != m) { exit 18i32; }
+                if ((c0.date.day => int64) != d)   { exit 18i32; }
+                if (c0.time.hour != 0u8 || c0.time.minute != 0u8) { exit 19i32; }
+                if (c0.time.second != 0u8 || c0.time.nanos != 0u32) { exit 19i32; }
+                CivilDateTime:c1 = raw timestamp_to_utc(a1.value);
+                if ((c1.date.year => int64) != y)  { exit 23i32; }
+                if ((c1.date.month => int64) != m) { exit 23i32; }
+                if ((c1.date.day => int64) != d)   { exit 23i32; }
+                if (c1.time.hour != 23u8 || c1.time.minute != 59u8) { exit 24i32; }
+                if (c1.time.second != 59u8 || c1.time.nanos != 999999999u32) { exit 24i32; }
+                secs = secs + NTIME_SECS_PER_DAY;
+                count = count + 1i64;
+            }
+        }
+    }
+    if (secs - 1i64 != NTIME_SECS_MAX) { exit 25i32; }
+    int32:said = raw say_swept(count);
+    if (said != 0i32) { exit said; }
+    exit 0i32;
+};
+
+// `swept <count>` and a newline, on stdout, exactly once -- the same helper
+// as `every_day_number.npk`'s, and every copy is checked on every run by the
+// harness reading what it printed.
+func:say_swept = int32(int64:count) never fails {
+    string:digits = int_to_string(count);
+    string:head = string_concat("swept ", digits);
+    string:line = string_concat(head, "\n");
+    Result<cstring>:c = to_cstring(line);
+    if (c.is_error) { pass 20i32; }
+    cstring:s = move(c.value);         // a `cstring` is move-only (TM-208)
+    Result<int64>:w = sys(1i64, 1i64, s.ptr, s.len);
+    if (w.is_error) { pass 21i32; }
+    if (w.value != s.len) { pass 22i32; }
+    pass 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (cal.ETimeValue)    { exit 80i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/sweep/every_sampled_second.npk b/tests/unit/sweep/every_sampled_second.npk
new file mode 100644
index 0000000000000000000000000000000000000000..a66dd2570861eccf221c137a38ec7a0b15dbff2a
--- /dev/null
+++ b/tests/unit/sweep/every_sampled_second.npk
@@ -0,0 +1,141 @@
+// expect-exit: 0
+// sweep-count: 44236800
+//
+// EVERY SECOND OF 512 DAYS CHOSEN AT RANDOM, AS A `Timestamp` AND AS A CIVIL
+// READING -- the second half of cycle 0.2's gate (`TESTING.md` V-2, V-4;
+// `TIME_MODEL.md` M-11; TM-224): 512 x 86 400 seconds, each from a
+// `Timestamp` to its civil reading and from the civil reading back. Run in
+// full, at -O0 and again under `opt -O2` (B-3), on every full invocation (B-9).
+//
+// WHAT THIS ADDS TO `every_day_boundary.npk`: every second of the day, where
+// that file takes two instants of each. A conversion that splits the second
+// of the day into hours, minutes and seconds wrongly -- a minute divided by
+// 61, a remainder taken twice -- is right at 00:00:00 and can be right at
+// 23:59:59, and is seen here at the second it goes wrong.
+//
+// THE DAYS ARE CHOSEN BY A SEED COMMITTED IN THIS FILE, so every run visits
+// the same 512 days and a failure reproduces. The generator is a 64-bit
+// xorshift -- `x ^= x << 13; x ^= x >> 7; x ^= x << 17` on a `uint64`, three
+// shifts and three exclusive-ors, none of which can trap -- begun at the seed
+// 20 261 001, the date the plan was written, chosen before any run; each step
+// gives one day, `NTIME_DAY_MIN + x mod 7 304 484`. Measured at planning,
+// beside a transcription of the same steps in Python: the 512 days are
+// distinct, 321 of them before the epoch, from -9875-01-21 to 9915-10-06.
+//
+// EACH DIRECTION IS HANDED THE WALK'S VALUE (`TESTING.md` V-4b, TM-174): the
+// hour, minute and second are three nested counts, and the instant is the
+// day's first second plus a COUNT of seconds, so neither conversion is held
+// to the other's answer. The date of a chosen day is `days_to_date`'s, which
+// the gate of cycle 0.1 holds to C-16 over the whole range. The reverse runs
+// first, so a `cal` constructor that refuses the walk's reading is seen at 11.
+//
+// THE COUNT IS THE EVIDENCE (`TESTING.md` V-16, TM-122): N is the seconds
+// that passed every check, and the harness requires it to equal the domain
+// declared above, which is tagged where the specifications state it
+// (`TESTING.md` V-1h, TM-168).
+//
+// Four `for` loops over ranges, bounded by construction: no `decreases`, no
+// `DecreasesViolated`, and the eleven identities of any program importing
+// `span` (`SAFETY.md` S-4) -- measured. The shifts' amounts are literals, so
+// no `ShiftRange` arm either.
+//
+// EXIT CODES, clear of every arm code (V-1j): 10 `days_to_date` refused a
+// chosen day; 11 `civil_time` refused the walk's reading; 12 `civil_to_utc`
+// refused it; 13 its answer is not the count; 14 `timestamp_of` refused the
+// count; 15 `timestamp_to_utc`'s date is not the chosen day's; 16 its time is
+// not the walk's; 17 a chosen day was not 86 400 seconds long; 20, 21 and 22
+// the `swept` line could not be built, could not be written, or was written
+// short. SEEN RED AT PLANNING, on both legs, in a copy of the tree
+// (`meta/roadmap/0.2/0.2.2.md`, step 3): 10 with `days_to_date` refusing a day
+// before the epoch; 11 with `civil_time` refusing second 59; 12 with
+// `civil_to_utc`'s day number multiplied by 1 000; 13 with its minutes counted
+// as 61 seconds; 15 with the floor's correction taking two days; 16 with the
+// minute divided by 61; 17 with the walk's last hour cut; and with the
+// correction deleted -- the truncation -- `civil_time` refuses the second
+// second of the first day before the epoch, and the file stops at 95,
+// `Unreachable`. 14 is a guard: `civil_to_utc` builds through the same
+// `timestamp_of`, so a constructor that refuses the count stops at 12 first.
+mod:every_sampled_second;
+
+use "../../../src/span/span.npk".*;
+use "../../../src/cal/cal.npk".CivilDate;
+use "../../../src/cal/cal.npk".CivilTime;
+use "../../../src/cal/cal.npk".CivilDateTime;
+use "../../../src/cal/cal.npk".days_to_date;
+use "../../../src/cal/cal.npk".civil_time;
+use "../../../src/core/limits.npk".NTIME_DAY_MIN;
+use "../../../src/core/limits.npk".NTIME_SECS_PER_DAY;
+
+func:main = int32(cstring[]:_~argv) {
+    uint64:x = 20261001u64;
+    int64:count = 0i64;
+    for (int64:k in 1i64..512i64) {
+        x = x ^ (x << 13u64);
+        x = x ^ (x >> 7u64);
+        x = x ^ (x << 17u64);
+        // `x mod 7 304 484` is below 2^23, so the narrowing keeps every bit of it.
+        int64:n = NTIME_DAY_MIN + ((x % 7304484u64) =>! int64);
+        Result<CivilDate>:cd = days_to_date(n);
+        if (cd.is_error) { exit 10i32; }
+        int64:first = n * NTIME_SECS_PER_DAY;
+        int64:s = 0i64;
+        for (int64:h in 0i64..23i64) {
+            for (int64:mi in 0i64..59i64) {
+                for (int64:se in 0i64..59i64) {
+                    Result<CivilTime>:ct = civil_time(h, mi, se, 0i64);
+                    if (ct.is_error) { exit 11i32; }
+                    Result<Timestamp>:b = civil_to_utc(CivilDateTime{ date: cd.value, time: ct.value });
+                    if (b.is_error) { exit 12i32; }
+                    if (b.value.secs != first + s || b.value.nanos != 0u32) { exit 13i32; }
+                    Result<Timestamp>:t = timestamp_of(first + s, 0i64);
+                    if (t.is_error) { exit 14i32; }
+                    CivilDateTime:c = raw timestamp_to_utc(t.value);
+                    if (c.date.year != cd.value.year || c.date.month != cd.value.month) { exit 15i32; }
+                    if (c.date.day != cd.value.day) { exit 15i32; }
+                    if ((c.time.hour => int64) != h || (c.time.minute => int64) != mi) { exit 16i32; }
+                    if ((c.time.second => int64) != se || c.time.nanos != 0u32) { exit 16i32; }
+                    s = s + 1i64;
+                    count = count + 1i64;
+                }
+            }
+        }
+        if (s != NTIME_SECS_PER_DAY) { exit 17i32; }
+    }
+    int32:said = raw say_swept(count);
+    if (said != 0i32) { exit said; }
+    exit 0i32;
+};
+
+// `swept <count>` and a newline, on stdout, exactly once -- the same helper
+// as `every_day_number.npk`'s, and every copy is checked on every run by the
+// harness reading what it printed.
+func:say_swept = int32(int64:count) never fails {
+    string:digits = int_to_string(count);
+    string:head = string_concat("swept ", digits);
+    string:line = string_concat(head, "\n");
+    Result<cstring>:c = to_cstring(line);
+    if (c.is_error) { pass 20i32; }
+    cstring:s = move(c.value);         // a `cstring` is move-only (TM-208)
+    Result<int64>:w = sys(1i64, 1i64, s.ptr, s.len);
+    if (w.is_error) { pass 21i32; }
+    if (w.value != s.len) { pass 22i32; }
+    pass 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (cal.ETimeValue)    { exit 80i32; },
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
