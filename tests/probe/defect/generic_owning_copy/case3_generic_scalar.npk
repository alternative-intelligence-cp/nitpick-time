// expect-error: NITPICK-TYPE-046
//
// CASE 3 -- THE NON-OWNING CONTROL: case1's generic function at `T = int64`.
//
// REFUSED SINCE COMPILER `c3bdae2`, AND THAT IS D-264 RATHER THAN A
// REGRESSION (cycle 0.1.0b, TM-154). It was written as the scalar control and
// until then it compiled and ran, as it should have under the old rule: there
// is nothing to move, so a copy of an element is a copy of an integer. Its job
// was to place the fault at GENERIC x OWNING and not at GENERIC alone -- the
// same three-control shape `generic_element_move` used for O-N17. D-264 moved
// the check from the instantiation to the BODY: a generic body is checked
// ONCE for every type it is instantiated at, so `T:answer = s[i]` is refused
// whatever `T` the caller supplies, `int64` included, and the diagnostic says
// so ("`T` is a type parameter, and this body is checked once for every type
// it is instantiated at"). So this file now shows the fix's REACH -- the
// refusal does not depend on the instantiation -- and it stays in the corpus
// for that. Its control, at the kept `aaffb87` pin, is `run:0`.
mod:case3_generic_scalar;

struct:Vec<T> = { wild T->:items; int64:count; int64:cap; };

func:vec_init<T> = Vec<T>(int64:cap) never fails {
    int64:n = cap;
    if (n < 1i64) { n = 1i64; }
    wild int8->:mem = alloc(n * #size_of<T>());
    pass Vec{ items: mem =>! wild T->, count: 0i64, cap: n };
};

func:vec_push<T> = NIL(Vec<T>->:v, move T:x) never fails {
    T[]:room = #wild_slice<T>(v.items, v.cap);
    room[v.count] = move(x);
    v.count = v.count + 1i64;
    pass NIL;
};

func:vec_free<T> = NIL(Vec<T>->:v) never fails {
    dalloc(v.items =>! wild int8->);
    v.count = 0i64;
    v.cap = 0i64;
    pass NIL;
};

func:peek<T> = T(Vec<T>->:v, int64:i) never fails {
    T[]:s = #wild_slice<T>(v.items, v.count);
    T:answer = s[i];
    pass answer;
};

func:main = int32(cstring[]:_~argv) {
    Vec<int64>:v = raw vec_init::<int64>(2i64);
    drop vec_push(@v, 7i64);
    int64:a = raw peek::<int64>(@v, 0i64);
    if (a != 7i64) { exit 10i32; }
    drop vec_free(@v);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom)        { exit 92i32; },
        (IntOverflow)    { exit 93i32; },
        (OutOfBounds)    { exit 94i32; },
        (Unreachable)    { exit 95i32; },
        (WildLeak)       { exit 96i32; },
        (*)              { exit 99i32; }
    }
    exit 9i32;
};

