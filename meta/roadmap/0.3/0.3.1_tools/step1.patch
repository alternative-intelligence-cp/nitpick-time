+_IR_DECLARE = re.compile(r"^declare [^\n]*?" + _IR_NAME + r"\(", re.M)
+_IR_GLOBAL = re.compile(r"^" + _IR_NAME + r" = ([^\n]*)$", re.M)
+_IR_REF = re.compile(_IR_NAME)
+_IR_MODULE = re.compile(r"npk\.([A-Za-z_][A-Za-z0-9_]*)\.")
