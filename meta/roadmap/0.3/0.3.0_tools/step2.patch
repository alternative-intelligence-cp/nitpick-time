+// The syscall numbers, x86-64 (TM-008), and the clock ids (H-4). 228 is the
+// one the compiler's runtime calls in `npk_mono_now` at the pin (`git show
+// 5fbaf4a:runtime/npkrt.ll`: `@npk_sys6(i64 228, i64 1, ...)`) and the kernel's
+// table names `clock_gettime`; 229 is in no file of the compiler's tree, and
+// the kernel's table names it `clock_getres` (`arch/x86/entry/syscalls/
+// syscall_64.tbl`, `meta/research/CURRENCY.md`), its behaviour measured at
+// cycle 0.3.0's planning: `{0 s, 1 ns}` for clocks 0, 1 and 7, and an errno in
+// the `Result` for 99. 0 and 7 are H-4's, and `probe03` measures them apart on
+// every run; 1 is the id the runtime's own call passes.
+fixed int64:SYS_CLOCK_GETTIME = 228i64;
+fixed int64:SYS_CLOCK_GETRES  = 229i64;
+fixed int64:CLOCK_REALTIME    = 0i64;
+fixed int64:CLOCK_MONOTONIC   = 1i64;
+fixed int64:CLOCK_BOOTTIME    = 7i64;
+
+// THE CLOCK `host_clock_res` IS ASKED ABOUT (H-1, TM-248). `host`'s own, three
+// variants, because `span`'s `InstantClock` has no realtime clock and must not
+// gain one: `instant_of(ns, InstantClock.Realtime)` would build an `Instant`
+// from the wall clock under the type's own name, the hazard M-3 exists for.
+#[derive(Eq, Clone, Debug, Copy)]
+pub enum:HostClock = { Realtime; Monotonic; Boottime; };
+
+// A `timespec`'s two fields as nanoseconds, or `ETimeValue` for a reading an
+// `int64` of nanoseconds cannot hold -- checked BEFORE the multiplication, so
+// nothing here traps (H-7's posture, `SAFETY.md` S-12). The range it answers
+// in is 0 ... `NTIME_DURATION_NS_MAX`; outside it -- a negative second among
+// it -- the detail is `ValueFault.Overflow`, and a nanosecond field outside one
+// second is `NanoRange`, each written here until `meta/OPEN_QUESTIONS.md` O-X8
+// says how a refusal hands its detail back. A kernel keeping its contract
+// meets none of them: the boot clock counts up from zero and a resolution is
+// a nanosecond here, so each is held by reading, not by a test (TM-249).
+func:timespec_ns = int64(int64:secs, int64:nanos) {
+    if (secs < 0i64)                  { fail ETimeValue; }     // Overflow
+    if (nanos < 0i64)                 { fail ETimeValue; }     // NanoRange
+    if (nanos >= NTIME_NANOS_PER_SEC) { fail ETimeValue; }     // NanoRange
+    int64:top = NTIME_DURATION_NS_MAX / NTIME_NANOS_PER_SEC;
+    if (secs > top)                   { fail ETimeValue; }     // Overflow
+    if (secs == top) {                                         // Overflow
+        if (nanos > (NTIME_DURATION_NS_MAX % NTIME_NANOS_PER_SEC)) { fail ETimeValue; }
+    }
+    pass (secs * NTIME_NANOS_PER_SEC) + nanos;
+};
+
+// `HOST.md` H-4, H-7 and H-8: `clock_gettime(CLOCK_REALTIME)`. The kernel's
+// errno is forwarded verbatim; the reading becomes a `Timestamp` through
+// `timestamp_of`, whose refusal of a `secs` outside the range (`YearRange`)
+// and of a `nanos` outside one second (`NanoRange`) IS H-8's range check -- an
+// unset machine clock is `ETimeValue`, not a value that fails later.
+//
+// THE TWO READS are of a 16-byte `buffer` at the offsets the `timespec` fixes,
+// slot 0 the seconds and slot 1 the nanoseconds -- in bounds by construction,
+// and through the bare pointer a `buffer` is indexed by, which no check here
+// can bound (`SAFETY.md` S-17b's fourth row). So it is said here.
+pub func:host_now_utc = Timestamp() {
+    buffer:ts = buffer_new(16i64);
+    Result<int64>:r = sys(SYS_CLOCK_GETTIME, CLOCK_REALTIME, ts.ptr);
+    if (r.is_error) { fail r.err; }
+    int64:secs = <-(#ptr_add<int64>(ts.ptr, 0i64));
+    int64:nanos = <-(#ptr_add<int64>(ts.ptr, 1i64));
+    pass (relay timestamp_of(secs, nanos));
+};
+
+// `HOST.md` H-5: the floor's `mono_now()`, not `clock_gettime` -- the clock the
+// deadline substrate reads, so an `Instant` from here and an executor deadline
+// are on one timeline by construction. `never fails`, as `mono_now` is, and
+// `raw` before `instant_of`, which is `never fails` too: the compiler asks for
+// it before a callee whose value is used.
+pub func:host_now_instant = Instant() never fails {
+    pass raw instant_of(mono_now(), InstantClock.Monotonic);
+};
+
+// `HOST.md` H-4 and H-6: `clock_gettime(CLOCK_BOOTTIME)`, which counts
+// suspend; the errno forwarded, the `timespec` turned into nanoseconds by
+// `timespec_ns`, and the `Instant` tagged `Boottime`, so `instant_since`
+// refuses it beside a `Monotonic` reading. The reads, as `host_now_utc`'s.
+pub func:host_now_boot = Instant() {
+    buffer:ts = buffer_new(16i64);
+    Result<int64>:r = sys(SYS_CLOCK_GETTIME, CLOCK_BOOTTIME, ts.ptr);
+    if (r.is_error) { fail r.err; }
+    int64:secs = <-(#ptr_add<int64>(ts.ptr, 0i64));
+    int64:nanos = <-(#ptr_add<int64>(ts.ptr, 1i64));
+    int64:ns = relay timespec_ns(secs, nanos);
+    pass raw instant_of(ns, InstantClock.Boottime);
+};
+
+// `HOST.md` H-1 and H-4: `clock_getres` on the clock `which` names -- the one
+// use of `CLOCK_MONOTONIC` here, H-5 holding for the reading -- the errno
+// forwarded, and the `timespec` through `timespec_ns` into a `Duration`. The
+// reads, as `host_now_utc`'s.
+pub func:host_clock_res = Duration(HostClock:which) {
+    int64:id = CLOCK_REALTIME;
+    pick (which) {
+        (HostClock.Realtime)  { id = CLOCK_REALTIME; },
+        (HostClock.Monotonic) { id = CLOCK_MONOTONIC; },
+        (HostClock.Boottime)  { id = CLOCK_BOOTTIME; }
+    }
+    buffer:ts = buffer_new(16i64);
+    Result<int64>:r = sys(SYS_CLOCK_GETRES, id, ts.ptr);
+    if (r.is_error) { fail r.err; }
+    int64:secs = <-(#ptr_add<int64>(ts.ptr, 0i64));
+    int64:nanos = <-(#ptr_add<int64>(ts.ptr, 1i64));
+    int64:ns = relay timespec_ns(secs, nanos);
+    pass raw duration_ns(ns);
+};
