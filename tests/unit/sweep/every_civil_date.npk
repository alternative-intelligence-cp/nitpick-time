// expect-exit: 0
// sweep-count: 7304484
//
// EVERY CIVIL DATE IN THE RANGE, TO ITS DAY NUMBER AND BACK -- the second
// half of `CALENDAR.md` C-16, cycle 0.1's gate (`TESTING.md` V-2, V-3;
// TM-026) -- AND MONOTONICITY, C-17's first rider, on the same walk. For every
// year in [NTIME_YEAR_MIN, NTIME_YEAR_MAX], every month, and every day
// `days_in_month` says that month has: `civil_date` accepts it, its day number
// is exactly one more than the previous date's (the first is NTIME_DAY_MIN,
// the last NTIME_DAY_MAX), and `days_to_date` of that number is the same date.
// Run in full, at -O0 and again under `opt -O2` (B-3), on every full
// invocation (B-9).
//
// THE DOMAIN IS THE CALENDAR, AND THAT IS WHAT THIS FILE ADDS TO ITS SIBLING.
// The dates are generated by the leap rule and the month table, never by
// `days_to_date`, so this is the direction that sees a validator accepting
// too much. With the century rule dropped, every century year that is not a
// multiple of 400 gains a February 29th -- 150 of them, -9900's the first the
// walk builds -- and it comes back from its day number as March 1st
// (exit 15). `every_day_number.npk` cannot see that; its dates come from
// Hinnant, who never produces them.
//
// "BY EXACTLY ONE", NOT "STRICTLY INCREASING", AND THE DIFFERENCE WAS
// MEASURED (`0.1.2.md` §5). C-17 asked for strictly increasing until cycle
// 0.1.2 and asks for this since. A leap rule that drops the 400-year leap day
// skips the 49 February 29ths of the multiples of 400 from -9600 to 9600, and
// every step of what remains still increases -- the dates that ARE walked all
// round-trip, the last one's number is still NTIME_DAY_MAX, and a `>` chain
// exits 0 having printed `swept 7304435`. Only the count and a `+ 1` chain see
// a day that was never visited. This file has both.
//
// AND THE WEEKDAY CYCLE, C-17's SECOND RIDER, ON THE SAME WALK SINCE CYCLE
// 0.1.3 (TM-165). Each date's `weekday` is compared with a COUNT that is 0 on
// -9999-01-01, a Monday, advances by one per date and goes back to 0 after 6,
// so on every day of the range the weekday is the one seven-day cycle begun
// on the range's first day, every century and 400-year boundary included. It
// rests on the `+ 1` chain above, which is the whole of what a weekday derived
// from the day number (C-13) needs from the calendar; what it adds is the
// derivation's own arithmetic. The Monday is not Hinnant's: Python's
// `date(1, 1, 1)` and `date(401, 1, 1)` are Mondays, -9999-01-01 lies 25 and
// 26 whole 400-year cycles before them, and 146 097 days is exactly 20 871
// weeks.
//
// "EQUALS THE COUNT", NOT "ADVANCES BY ONE, MOD SEVEN", AND THE DIFFERENCE
// WAS MEASURED (`0.1.3.md` §7, TM-167). A weekday whose `%` correction is
// missing is wrong on six days in seven before 1969-12-29, and a weekday one
// day late is wrong on every day; the numbers `weekday_number` reads off both
// still advance by one, mod seven, on all 7 304 483 steps, and a check of
// that exits 0 with the full count. The count catches the first on the
// range's second day and the second on its first.
//
// THE COUNT IS THE EVIDENCE (`TESTING.md` V-16, TM-122): N is the dates that
// passed every check, and the harness requires it to equal the domain
// declared above. Here the count is also a recomputation: it is how many days
// the leap rule and the month table say the range holds, so a harness that
// agrees with the header agrees with `CALENDAR.md` §2 by a second route. The
// declared domain is tagged where the specifications state it
// (`TESTING.md` V-1h).
//
// Three `for` loops over ranges, bounded by construction: no `decreases`, no
// `DecreasesViolated`, and the eleven identities of any program importing
// `cal` (`SAFETY.md` S-4) -- measured.
//
// EXIT CODES, clear of every arm code (V-1j): 10 `days_in_month` refused a
// month from 1 to 12; 11 `civil_date` refused a date the month's length
// admits; 12 the first date is not NTIME_DAY_MIN; 13 a date's day number is
// not the previous one's plus one; 14 `days_to_date` refused a day number
// this walk reached; 15 it returned a different date; 16 the last date is not
// NTIME_DAY_MAX; 17 a date's weekday is not the count's; 20, 21 and 22 the
// `swept` line could not be built, could not be written, or was written short.
mod:every_civil_date;

use "../../../src/cal/cal.npk".CivilDate;
use "../../../src/cal/cal.npk".civil_date;
use "../../../src/cal/cal.npk".days_in_month;
use "../../../src/cal/cal.npk".date_to_days;
use "../../../src/cal/cal.npk".days_to_date;
use "../../../src/cal/cal.npk".weekday;
use "../../../src/cal/cal.npk".weekday_number;
use "../../../src/core/limits.npk".NTIME_YEAR_MIN;
use "../../../src/core/limits.npk".NTIME_YEAR_MAX;
use "../../../src/core/limits.npk".NTIME_DAY_MIN;
use "../../../src/core/limits.npk".NTIME_DAY_MAX;

func:main = int32(cstring[]:_~argv) {
    int64:count = 0i64;
    int64:prev = 0i64;
    int64:wk = 0i64;
    for (int64:y in NTIME_YEAR_MIN..NTIME_YEAR_MAX) {
        for (int64:m in 1i64..12i64) {
            Result<int64>:dim = days_in_month(y, m);
            if (dim.is_error) { exit 10i32; }
            for (int64:d in 1i64..dim.value) {
                Result<CivilDate>:c = civil_date(y, m, d);
                if (c.is_error) { exit 11i32; }
                int64:n = raw date_to_days(c.value);
                if (count == 0i64) {
                    if (n != NTIME_DAY_MIN) { exit 12i32; }
                } else {
                    if (n != prev + 1i64)   { exit 13i32; }
                }
                Result<CivilDate>:back = days_to_date(n);
                if (back.is_error) { exit 14i32; }
                CivilDate:b = back.value;
                if ((b.year => int64) != y)  { exit 15i32; }
                if ((b.month => int64) != m) { exit 15i32; }
                if ((b.day => int64) != d)   { exit 15i32; }
                if (raw weekday_number(raw weekday(c.value)) != wk + 1i64) { exit 17i32; }
                wk = wk + 1i64;
                if (wk == 7i64) { wk = 0i64; }
                prev = n;
                count = count + 1i64;
            }
        }
    }
    if (prev != NTIME_DAY_MAX) { exit 16i32; }
    int32:said = raw say_swept(count);
    if (said != 0i32) { exit said; }
    exit 0i32;
};

// `swept <count>` and a newline, on stdout, exactly once -- the same helper
// as `every_day_number.npk`'s, and every copy is checked on every run by the
// harness reading what it printed.
func:say_swept = int32(int64:count) never fails {
    string:digits = int_to_string(count);
    string:head = string_concat("swept ", digits);
    string:line = string_concat(head, "\n");
    Result<cstring>:c = to_cstring(line);
    if (c.is_error) { pass 20i32; }
    cstring:s = c.value;
    Result<int64>:w = sys(1i64, 1i64, s.ptr, s.len);
    if (w.is_error) { pass 21i32; }
    if (w.value != s.len) { pass 22i32; }
    pass 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
