// expect-error: NITPICK-TYPE-079
//
// PROBE 21b — A CONSUMER CANNOT DENORMALISE A `Timestamp` IT HOLDS (cycle
// 0.2.1, TM-219, TM-221; `TIME_MODEL.md` M-7).
//
// ASKS: may a consumer take a `Timestamp` from `timestamp_of` and write
// `t.nanos = 1500000000u32` -- the operation that would turn a value the
// constructor checked into one it refuses?
//
// MATTERS BECAUSE `VERIFICATION.md` P-4 asks that NO SEQUENCE OF OPERATIONS
// produce a denormalised value, and a field write is the one operation a
// consumer has that is not the library's. ANSWER, measured at `5fbaf4a`: NO
// -- `NITPICK-TYPE-079`, exactly once: `nanos` is `sealed`, written only in
// `span` (the compiler's D-313). THE REFUSAL IS THE ASSERTION (B-7).
// `probe21` is the literal.
mod:probe21b_timestamp_field_write_refused;

use "../../src/span/span.npk".*;

func:main = int32(cstring[]:_~argv) {
    Result<Timestamp>:r = timestamp_of(0i64, 500000000i64);
    if (r.is_error) { exit 10i32; }
    Timestamp:t = r.value;
    t.nanos = 1500000000u32;
    exit 0i32;
};

// A SUPERSET of what `NITPICK-REACH-002` asks of a root importing `span`,
// deliberately, as `probe16d` has (`SAFETY.md` S-6b, constraint 3: a superset
// compiles): a later compiler that ran the reach analysis before the check this
// file asserts could not add a stray `REACH-002` to the refusal.
func:failsafe = int32(Error:e) {
    pick (e) {
        (cal.ETimeValue)    { exit 80i32; },
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (DecreasesViolated) { exit 108i32; },
        (LimitViolated)     { exit 109i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
