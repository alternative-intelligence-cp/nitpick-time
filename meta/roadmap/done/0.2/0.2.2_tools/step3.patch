+        if ((c.date.year => int64) != YEAR[i])   { exit 15i32; }
+        if ((c.date.month => int64) != MONTH[i]) { exit 15i32; }
+        if ((c.date.day => int64) != DAY[i])     { exit 15i32; }
+        if ((c.time.hour => int64) != HOUR[i])   { exit 16i32; }
+        if ((c.time.minute => int64) != MIN[i])  { exit 16i32; }
+        if ((c.time.second => int64) != SEC[i])  { exit 16i32; }
+        if ((c.time.nanos => int64) != NANOS[i]) { exit 17i32; }
+    }
+    exit 0i32;
+};
